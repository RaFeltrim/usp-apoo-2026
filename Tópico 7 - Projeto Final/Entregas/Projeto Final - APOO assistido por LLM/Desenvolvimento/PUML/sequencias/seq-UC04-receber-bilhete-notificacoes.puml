@startuml
actor Passageiro
participant "u : Usuario" as Usuario
participant "n : Notificacao" as Notificacao
participant "sn : ServicoNotificacoes" as ServicoNotificacoes

[-> Notificacao : dispararNotificacao(usuario, canal, conteudo)
activate Notificacao
Notificacao -> Usuario : obterContatoPreferencial()
activate Usuario
Usuario --> Notificacao : contatoPreferencial
deactivate Usuario

Notificacao -> Notificacao : comporMensagem(destinatario, canal, conteudo)
Notificacao -> ServicoNotificacoes : enviarMensagem(canal, destinatario, conteudo)
activate ServicoNotificacoes

alt entrega bem-sucedida
  ServicoNotificacoes --> Passageiro : entregaEmailOuWhatsApp
  ServicoNotificacoes --> Notificacao : statusEntregue
  Notificacao -> Notificacao : atualizarStatusEnvio(status)
else falha no servico externo
  ServicoNotificacoes --> Notificacao : erroEnvio
  Notificacao -> Notificacao : atualizarStatusEnvio(status)
end
deactivate ServicoNotificacoes
[<-- Notificacao : resultadoEnvio
deactivate Notificacao
@enduml
